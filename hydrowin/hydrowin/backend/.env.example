# HYDROWIN backend — скопируйте в backend/.env

ENVIRONMENT=development

DATABASE_URL=postgresql://hydrowin:hydrowin_secret@db:5432/hydrowin

JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

API_HOST=0.0.0.0
API_PORT=8090
CORS_ORIGINS=http://localhost:8080

ALLOW_PUBLIC_REGISTER=false
DEFAULT_DEVICE_KEY=hydro-demo-device-key

# MQTT опционален (LAN). Продакшен: телеметрия по HTTPS, MQTT_ENABLED=false.
# Если включаете — задайте уникальные пароли ≥16 символов (не change-me-*).
MQTT_ENABLED=false
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_API_USER=hydrowin-api
MQTT_API_PASSWORD=change-me-mqtt-api
MQTT_DEVICE_USER=hydrowin-device
MQTT_DEVICE_PASSWORD=change-me-mqtt-device

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Если api.telegram.org недоступен с сервера — HTTP-прокси (или VPN на хосте).
# TELEGRAM_PROXY_URL=http://host.docker.internal:7890

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_gmail@gmail.com
SMTP_FROM_NAME=HydroWin
SMTP_STARTTLS=true
SMTP_SSL=false

BLOCK_WS_ENABLED=false
BLOCK_WS_URL=ws://192.168.1.34:81

MACHINE_CODE=1783422691603

API_DOMAIN=app.hydrowin.ru
APP_DOMAIN=app.hydrowin.ru
ACME_EMAIL=admin@hydrowin.ru

# Масштабирование (100+ плат, опрос 1 с)
UVICORN_WORKERS=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
READINGS_RETENTION_DAYS=30
READINGS_ARCHIVE_DAYS=180
READINGS_PURGE_INTERVAL_HOURS=24

# Локация по соте GSM/LTE (когда GNSS нет фикса).
# Свой кэш в PostgreSQL — бесплатно (учится по GNSS / ручной точке).
# OpenCellID (опционально): https://opencellid.org → API token
# OPENCELLID_API_KEY=
