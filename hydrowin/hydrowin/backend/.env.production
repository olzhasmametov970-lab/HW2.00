# Production: app.hydrowin.ru → Ubuntu VM (Caddy)
# Скопируйте на сервер как backend/.env перед docker compose up
#
# ОБЯЗАТЕЛЬНО:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production

# HTTPS (Caddy). Кабинет + API на одном хосте.
API_DOMAIN=app.hydrowin.ru
APP_DOMAIN=app.hydrowin.ru
ACME_EMAIL=admin@hydrowin.ru

DATABASE_URL=postgresql://hydrowin:REPLACE_DB_PASSWORD@db:5432/hydrowin

JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET_MINIMUM_LENGTH_OK
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

API_HOST=0.0.0.0
API_PORT=8090
CORS_ORIGINS=

ALLOW_PUBLIC_REGISTER=false
DEFAULT_DEVICE_KEY=REPLACE_UNIQUE_DEVICE_KEY

# MQTT — сгенерируйте пароли (≥16 символов)
MQTT_ENABLED=false
MQTT_API_USER=hydrowin-api
MQTT_API_PASSWORD=REPLACE_MQTT_API_PASSWORD_MIN_16_CHARS
MQTT_DEVICE_USER=hydrowin-device
MQTT_DEVICE_PASSWORD=REPLACE_MQTT_DEVICE_PASSWORD_MIN_16_CHARS

AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
INGEST_RATE_LIMIT=120
INGEST_RATE_WINDOW_SECONDS=60

MACHINE_CODE=1783422691603
