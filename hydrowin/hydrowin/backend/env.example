# HYDROWIN backend — переменные окружения
# Скопируйте в backend/.env и поменяйте значения

# ─── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL = "postgresql://admin:my_secret_password@localhost:5432/hydrowin_db"

engine = create_engine(DATABASE_URL)

# ─── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=замените-на-случайную-строку-минимум-32-символа
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── BLOCK WebSocket URL ──────────────────────────────────────────────────────
# Текущее значение (локальная сеть):
BLOCK_WS_URL=ws://192.168.1.34:81

# После переезда BLOCK на производство — просто смените строку ниже
# и перезапустите контейнер (docker compose restart api):
# BLOCK_WS_URL=ws://10.0.0.50:81
# BLOCK_WS_URL=ws://производство.вашдомен.ru:81
